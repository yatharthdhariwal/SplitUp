# -----------------------------------------------------------------------
# SplitWise Clone — Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it contains secrets!
# -----------------------------------------------------------------------

# Flask environment: 'development' or 'production'
FLASK_ENV=development

# Secret key for Flask session signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# JWT signing secret — use a different value from SECRET_KEY
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-here

# How long JWT tokens stay valid (in minutes)
# Development: 60 mins    Production: 15 mins recommended
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# PostgreSQL connection string
# Local:       postgresql://username:password@localhost:5432/splitwise_db
# Neon (prod): postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/splitwise_db?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/splitwise_db

# CORS: which frontend origins are allowed to call this API
# Development: * (any)    Production: https://your-frontend-domain.com
ALLOWED_ORIGINS=*
